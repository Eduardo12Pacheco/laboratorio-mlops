# Copy to .env (never commit it) to override the Compose defaults.
# The stack needs no keys by default; everything runs locally and offline.

# Compose project name (must match the repository for this portfolio machine).
COMPOSE_PROJECT_NAME=mlops-lifecycle-lab

# Simulated seconds per replayed week. The compose smoke test sets this to 1.
MLL_REPLAY_INTERVAL_SECONDS=20

# Optional admin key for POST /v1/admin/reload. Leave empty to keep it open on loopback.
MLL_ADMIN_API_KEY=
